process {
    executor      = 'slurm'
    errorStrategy = 'retry'
    maxRetries    = 2
    
    // Global fallback ========================================================
    cpus   = 1
    memory = { 16.GB * task.attempt }
    time   = { 1.h * task.attempt }

    // Process specific =======================================================
    withName: 'splatter' {
        cpus   = 8
        memory = { 64.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    withName: 'scdesign3' {
        cpus   = 8
        memory = { 64.GB * task.attempt } 
        time   = { 24.h * task.attempt }
    }
}

executor {
    queueSize = 2000
}