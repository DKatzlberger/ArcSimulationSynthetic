process {
    executor      = 'slurm'
    errorStrategy = 'retry'
    maxRetries    = 0
    
    // Global fallback ========================================================
    cpus   = 1
    memory = { 32.GB * task.attempt }
    time   = { 2.h * task.attempt }

    // Process specific =======================================================
    withName: 'splatter' {
        cpus   = 8
        memory = { 64.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withName: 'scdesign3_offtarget_none' {
        cpus   = 8
        memory = { 128.GB * task.attempt } 
        time   = { 24.h * task.attempt }
    }

    withName: 'visualize' {
        cpus   = 1                      
        memory = { 64.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
}